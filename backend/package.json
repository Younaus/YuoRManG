{
  "name": "yourmang-backend",
  "version": "0.2.0",
  "private": true,
  "description": "YouRManG Task Manager API (Firebase Cloud Functions Gen 2 + Express)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:unit": "npm run build && node --test \"test/**/*.test.mjs\"",
    "migrate:search-tokens": "npm run build && node scripts/backfill-search-tokens.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "helmet": "^8.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^7.0.2"
  }
}
