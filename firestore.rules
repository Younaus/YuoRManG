rules_version = '2';

// Tüm veri erişimi backend API (Admin SDK) üzerinden yapılır.
// Admin SDK bu kuralları bypass eder; istemcilerin doğrudan erişimi kapalıdır.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
